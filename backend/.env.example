# Copy to .env and fill in. The .env file is never committed.

# Local MongoDB running as the single-node replica set rs0 (needed for transactions).
MONGODB_URL=mongodb://localhost:27017/?replicaSet=rs0
DATABASE_NAME=seatwise

# At least 32 bytes. The app refuses to start with this placeholder. Generate one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# Refresh token lifetime, and whether its cookie is sent over https only.
# Set REFRESH_COOKIE_SECURE=true in production.
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_SECURE=false
